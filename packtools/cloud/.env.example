# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.
#
# R2 credentials — from 'CloudFlare R2 Bucket Keys.txt' (navdata-bucket-scoped).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
#
# Manifest signing key: the base64 blob = the full contents of keys/minisign.sec.
# _load_secret() reads this env first; no key file is mounted into the container.
MINISIGN_SECRET_KEY=<base64 signing blob>
