# Normalise to LF in the repo; the build runs on Linux CI and the Pi.
* text=auto eol=lf

# Signature/key files are ASCII but order-sensitive — keep them verbatim LF.
*.pub text eol=lf
*.minisig text eol=lf

# Recorded upstream responses are kept byte for byte (their sha256 is part
# of what the gnss tests check).
tests/fixtures/gnss/navcen-*/** -text
